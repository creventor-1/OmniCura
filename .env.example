# Google Gemini API (Server-side only)
GEMINI_API_KEY=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Zcash notary (shielded utest1 address). The app never holds the spending key:
# anchoring is done by the notary sidecar (npm run notary:sidecar).
ZCASH_NETWORK=testnet
ZCASH_LIGHTWALLETD_URL=https://testnet.zec.rocks:443
ZCASH_NOTARY_ADDRESS=
ZCASH_NOTARY_SIDECAR_URL=http://127.0.0.1:8737
# 64 random hex chars, shared with the sidecar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZCASH_NOTARY_SIDECAR_TOKEN=
