# Copy to .env.notary (gitignored). Read ONLY by scripts/zcash-notary-sidecar.mjs —
# never by the Next.js app. ZCASH_NOTARY_ADDRESS / ZCASH_NOTARY_SIDECAR_TOKEN are
# also read from .env.local, so they don't need repeating here.

# Seed phrase of the wallet that owns ZCASH_NOTARY_ADDRESS (utest1…).
# Only needed for the FIRST run, to restore the wallet into ZINGO_DATA_DIR.
# You can delete it from this file once the sidecar reports "Wallet open".
ZINGO_SEED=
# Block height when that wallet was created (speeds up the first sync a lot).
ZCASH_NOTARY_BIRTHDAY=

# Path to the zingo-cli binary (built with: makers run-cli --build-only; keep nym-proxy beside it)
ZINGO_CLI_PATH=zingo-cli
# Where the notary wallet lives. Keep it OUTSIDE the repo.
# ZINGO_DATA_DIR=/home/you/.omnicura-notary-wallet

# Amount (zatoshis) sent to self per anchor; it returns to the same wallet.
ZCASH_ANCHOR_AMOUNT_ZATS=1000
# ZCASH_NOTARY_SIDECAR_HOST=127.0.0.1
# ZCASH_NOTARY_SIDECAR_PORT=8737
